# Токен бота MAX (получить у бота-администратора)
# MAX_BOT_TOKEN=your_bot_token_here

# Токены сообществ VK.
# Ключ собирается из имени канала: VK_ACCESS_TOKEN_<NAME>, где
# <NAME> — имя канала в верхнем регистре (ADR 0022, п. 3).
# Токен выпускается в настройках сообщества: «Работа с API» →
# «Создать ключ». Тип — сообщество, не пользователь.
# Права: wall, photos, manage (ADR 0022, п. 6).
#
# Пример для канала name=vk_main:
# VK_ACCESS_TOKEN_VK_MAIN=your_vk_token_here