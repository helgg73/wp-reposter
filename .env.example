# Токен бота MAX (получить у бота-администратора)
MAX_BOT_TOKEN=your_bot_token_here

# ID чата или username канала (например, @my_channel или -100123456789)
MAX_CHAT_ID=your_chat_id_here

# URL RSS ленты (если он приватный или отличается от дефолтного в YAML)
# Если оставить пустым, будет использован URL из config/settings.yaml
TEST_RSS_URL=
